# ─── PostgreSQL ───────────────────────────────
POSTGRES_USER=recits
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=recits_perdus
# DB_PORT=5432

# ─── Holocron (API) ──────────────────────────
ACCESS_TOKEN_SECRET=change_me_random_secret

# Discord integration (optional)
DISCORD_ENABLED=false
# DISCORD_HOLONET_WEBHOOK_ID=
# DISCORD_HOLONET_WEBHOOK_TOKEN=
# DISCORD_HOLONET_APP_TOKEN=
# DISCORD_HOLONET_CHANNEL_ID=

# File storage paths (defaults work with Docker volumes)
# PUBLIC_FOLDER_PATH=/app/public/images
# USERS_FOLDER_PATH=users/avatars
# POSTS_FOLDER_PATH=posts/illustrations
# NOTES_FOLDER_PATH=notes/illustrations

# ─── Gizka (Frontend) ────────────────────────
# These NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# Set them to the public-facing URLs of your deployment.
NEXT_PUBLIC_IMAGES_PREFIX_URL=http://localhost:8080/images
NEXT_PUBLIC_BFF_PREFIX_URL=http://localhost:8080
NEXT_PUBLIC_BFF_PREFIX_HOSTNAME=localhost
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_DISCORD_LINK=

# ─── Ports (optional overrides) ──────────────
# HOLOCRON_PORT=8080
# GIZKA_PORT=3000
